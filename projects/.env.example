# DeepSeek（必填：模型调用）
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 默认模型（config/*.json 中可覆盖）
DEEPSEEK_MODEL="deepseek-chat"

# PostgreSQL（可选：不设则检查点退化到内存 MemorySaver）
PGDATABASE_URL="postgresql://postgres:123456@127.0.0.1:5432/postgres"

# Langfuse Cloud（可选：注册后在 Project Settings 复制；不配则追踪禁用）
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# EU: https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com

# eval/run.py
EVAL_BASE_URL=http://127.0.0.1:5000
